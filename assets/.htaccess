# Cache navigateur des fichiers statiques (Apache, junior.utbm.fr).
# Ce fichier ne touche que /assets/ : le .htaccess racine appartient à WordPress
# et au plugin Junior Static Deploy. GitHub Pages l'ignore (cache de 10 min imposé).
#
# Les noms de fichiers ne sont pas versionnés : une durée longue garderait l'ancienne
# version chez les visiteurs après une mise à jour. D'où des durées par type :
# - polices : 1 an, elles ne changent jamais (changer de police = nouveau nom de fichier) ;
# - images et PDF : 7 jours ;
# - CSS et JS : 1 heure, puis revalidation par ETag (réponse 304, quasi gratuite).

<IfModule mod_headers.c>
  <FilesMatch "\.(woff2?|ttf|otf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(svg|png|jpe?g|webp|avif|gif|ico|pdf)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
</IfModule>

# Compression des formats texte (les images et polices sont déjà compressées).
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/css application/javascript text/javascript image/svg+xml
</IfModule>
